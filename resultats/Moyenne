#!/usr/bin/env python3
"""
Compute, for each search algorithm, the average over all problems and all tries of:
execution time
number of iterations (last value of the first column)
number of states explored
number of generated states (last cumulative value in each file)
Expected file format (one file per try, e.g. "breadth_essai1.csv"):
<iteration>\t<cumulative generated states> <- one line per iteration
...
<total states explored> <- second-to-last line
<time> <- last line
The algorithm name is taken from the file name: everything before "_essai".
The folder is scanned recursively, so any tree layout works
(e.g. root/problem1/breadth_essai1.csv, root/problem2/astar_essai3.csv, ...).
Usage:
python average_stats.py <C:/Users/renau/6GEI608_lab1/resultats>
"""
import csv
import os
import re
import sys
from collections import defaultdict
from collections import deque


FILE_PATTERN = re.compile(r"^(?P<algo>.+?)_essai(?P<try>\d+)\.csv$", re.IGNORECASE)

# Les fichiers contiennent le temps en nanosecondes (time.time_ns()).
# Mettre 1 si data.writeData écrit déjà le temps en secondes.
TIME_DIVISOR = 1_000_000_000

# Pour A*, la 2e colonne contient la taille de la liste des états explorés,
# pas le nombre cumulé d'états générés : la moyenne "générés" n'a pas de sens.
NO_GENERATED_PREFIX = "astar"

def to_number(text):
	"""Parse a number, accepting both '1.5' and '1,5'."""
	return float(text.strip().replace(",", "."))

def parse_file(path):
	"""Return iterations, explored states, time and generated states."""
	last_values = deque(maxlen=2)
	last_iteration = 0.0
	generated_states = 0.0

	with open(path, "r", encoding="utf-8-sig") as f:
		for raw_line in f:
			line = raw_line.strip()
			if not line:
				continue

			if len(last_values) == 2:
				data_line = last_values.popleft()
				parts = re.split(r"[\s;,]+", data_line)
				if len(parts) < 2:
					raise ValueError(f"expected 2 columns, got: {data_line!r}")
				last_iteration = to_number(parts[0])
				generated_states = to_number(parts[1])

			last_values.append(line)

	if len(last_values) != 2 or last_iteration == 0.0:
		raise ValueError("file too short")

	states_explored = to_number(last_values[0])
	execution_time = to_number(last_values[1]) / TIME_DIVISOR
	return last_iteration, states_explored, execution_time, generated_states

def mean(values):
	return sum(values) / len(values) if values else 0.0

def generated_text(algorithm, values, width=None):
	if algorithm.startswith(NO_GENERATED_PREFIX):
		text = "n/a"
	else:
		text = f"{mean(values['generated']):.2f}"
	return f"{text:>{width}}" if width else text

def main():
	if len(sys.argv) > 1:
		root = sys.argv[1]
	else:
		root = os.path.dirname(os.path.abspath(__file__))

	if not os.path.isdir(root):
		sys.exit(f"Error: '{root}' is not a folder.")

	stats = defaultdict(
		lambda: {
			"time": [],
			"iterations": [],
			"states": [],
			"generated": [],
			"problems": set(),
		}
	)

	for dirpath, _, filenames in os.walk(root):
		for name in sorted(filenames):
			match = FILE_PATTERN.match(name)
			if not match:
				continue

			path = os.path.join(dirpath, name)
			try:
				iterations, states, execution_time, generated = parse_file(path)
			except (ValueError, IndexError) as error:
				print(f"Skipping {path}: {error}", file=sys.stderr)
				continue

			algorithm = match.group("algo").lower()
			values = stats[algorithm]
			values["time"].append(execution_time)
			values["iterations"].append(iterations)
			values["states"].append(states)
			values["generated"].append(generated)
			values["problems"].add(os.path.relpath(dirpath, root))

	if not stats:
		sys.exit("No '<algorithm>_essai<N>.csv' files found.")

	header = (
		f"{'Algorithm':<26}{'Problems':>10}{'Runs':>8}"
		f"{'Avg time (s)':>14}{'Avg iterations':>16}"
		f"{'Avg explored':>14}{'Avg generated':>16}"
	)
	output_lines = [header, "-" * len(header)]
	for algorithm in sorted(stats):
		values = stats[algorithm]
		output_lines.append(
			f"{algorithm:<26}{len(values['problems']):>10}{len(values['time']):>8}"
			f"{mean(values['time']):>14.6f}"
			f"{mean(values['iterations']):>16.2f}"
			f"{mean(values['states']):>14.2f}"
			f"{generated_text(algorithm, values, 16)}"
		)

	print("\n".join(output_lines))
	output_path = os.path.join(root, "Moyenne.csv")
	with open(output_path, "w", newline="", encoding="utf-8") as output_file:
		writer = csv.writer(output_file, delimiter="\t")
		writer.writerow([
			"Algorithm",
			"Problems",
			"Runs",
			"Avg time (s)",
			"Avg iterations",
			"Avg explored",
			"Avg generated",
		])
		for algorithm in sorted(stats):
			values = stats[algorithm]
			writer.writerow([
				algorithm,
				len(values["problems"]),
				len(values["time"]),
				f"{mean(values['time']):.6f}",
				f"{mean(values['iterations']):.2f}",
				f"{mean(values['states']):.2f}",
				generated_text(algorithm, values),
			])
	print(f"\nRésultats sauvegardés dans : {output_path}")

if __name__ == "__main__":
	main()